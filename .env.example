# Azure AD / Microsoft Entra ID
# Get these from Azure Portal > App Registrations > Your App
AZURE_AD_CLIENT_ID=your-client-id-here
AZURE_AD_CLIENT_SECRET=your-client-secret-here
AZURE_AD_TENANT_ID=your-tenant-id-here

# NextAuth
# NEXTAUTH_URL should be your production URL in production
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=generate-a-random-32-char-string-here

# SharePoint Configuration
# Your SharePoint hostname (e.g., contoso.sharepoint.com)
SHAREPOINT_HOSTNAME=your-company.sharepoint.com
# Path to your SharePoint site (e.g., /sites/MySite)
SHAREPOINT_SITE_PATH=/sites/YourSite
# Name of the document library/drive containing your Excel file
SHAREPOINT_DRIVE_NAME=Documents
# Path to the Excel file within the drive
EXCEL_FILE_PATH=/path/to/your/file.xlsx
