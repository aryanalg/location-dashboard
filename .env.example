# Azure AD / Microsoft Entra ID
# Get these from Azure Portal > App Registrations > Your App
AZURE_AD_CLIENT_ID=your-client-id-here
AZURE_AD_CLIENT_SECRET=your-client-secret-here
AZURE_AD_TENANT_ID=your-tenant-id-here

# NextAuth
# NEXTAUTH_URL should be your production URL in production
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=generate-a-random-32-char-string-here

# Optional shared rate limiting (recommended for production)
# If unset, app falls back to in-memory per-instance limits
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SharePoint Configuration
# Your SharePoint hostname (e.g., contoso.sharepoint.com)
SHAREPOINT_HOSTNAME=your-company.sharepoint.com
# Path to your SharePoint site (e.g., /sites/MySite)
SHAREPOINT_SITE_PATH=/sites/YourSite
# Name of the document library/drive containing your Excel file
SHAREPOINT_DRIVE_NAME=Documents
# Path to the Excel file within the drive
EXCEL_FILE_PATH=/path/to/your/file.xlsx

# Optional worksheet selection overrides (comma-separated exact tab names)
# Example: EXCEL_SHEET_INCLUDE_LIST=40413,41393,43015
EXCEL_SHEET_INCLUDE_LIST=
EXCEL_SHEET_EXCLUDE_LIST=

# Optional regex filters (applied case-insensitively to worksheet names)
# Example: EXCEL_SHEET_INCLUDE_REGEX=^(\\d{4,5})
# Example: EXCEL_SHEET_EXCLUDE_REGEX=(summary|pivot|archive)
EXCEL_SHEET_INCLUDE_REGEX=
EXCEL_SHEET_EXCLUDE_REGEX=

# PO tab naming rule (new standard: CUSTOMER-PO, e.g. C0640-40413 or C0553F-VPO12)
# Use this to adapt when new customers introduce a different PO format
EXCEL_PO_SHEET_REGEX=^C[A-Z0-9]+-[A-Z0-9]+$

# Migration mode for legacy tabs (e.g. 40413 or 40413 (P)); set to false after renaming tabs
EXCEL_ALLOW_LEGACY_PO_SHEETS=true

# Optional import diagnostics logging
EXCEL_IMPORT_LOG=false
